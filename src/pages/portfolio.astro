---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { brand } from "../config/brand";
---

<BaseLayout
  title="Our Portfolio"
  description={`How working with ${brand.name} works from the first conversation to delivery and post-launch support.`}
>
  <Header slot="header" />

  <Banner title="Our Portfolio" />

  <!-- Overview + timeline -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
          Our Portfolio
        </h2>
        <p class="mt-4 text-text-muted leading-relaxed">Coming soon!</p>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
