---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { Image } from "astro:assets";
import { brand } from "../config/brand";
import { siteData } from "../data/siteData";

const { about } = siteData;
---

<BaseLayout
  title="Team"
  description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}
>
  <Header slot="header" />

  <Banner title="Our Team" />

  <!-- Team -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
          Executive Board
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          about.team.executive.map(({ name, role, image }) => (
            <div class="overflow-hidden rounded-lg bg-background shadow-sm">
              <Image
                src={image}
                alt={name}
                width={400}
                height={400}
                loading="lazy"
                class="aspect-square w-full object-cover"
              />
              <div class="p-5">
                <h3 class="font-heading text-lg font-semibold text-text">
                  {name}
                </h3>
                <p class="text-sm text-text-muted">{role}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div style="height: 75px; width: 100%; margin-bottom: 2rem;"></div>

      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
          Consultants
        </h2>
      </div>

      <div
        class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
      >
        {
          about.team.consultants.map(({ name }) => (
            <div class="flex items-center justify-center rounded-lg border border-border bg-background px-7 py-7 text-center shadow-sm transition-shadow hover:shadow-md">
              <h3 class="font-heading text-base font-bold text-text">{name}</h3>
            </div>
          ))
        }
      </div>

      <div style="height: 75px; width: 100%; margin-bottom: 2rem;"></div>

      <!-- <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
          Alumni
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          about.team.alumni.map(({ name, role, image }) => (
            <div class="overflow-hidden rounded-lg bg-background shadow-sm">
              <Image
                src={image}
                alt={name}
                width={400}
                height={400}
                loading="lazy"
                class="aspect-square w-full object-cover"
              />
              <div class="p-5">
                <h3 class="font-heading text-lg font-semibold text-text">
                  {name}
                </h3>
                <p class="text-sm text-text-muted">{role}</p>
              </div>
            </div>
          ))
        }
      </div> -->
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
